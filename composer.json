{
    "name": "app/symfony-api-base",
    "description": "Symfony 7 + API Platform 4 base template",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/doctrine-orm": "^4.2.20",
        "api-platform/symfony": "^4.2.20",
        "doctrine/dbal": "^4.4.2",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6.2",
        "knplabs/knp-snappy-bundle": "^1.10.6",
        "lexik/jwt-authentication-bundle": ">=3.2.0",
        "nelmio/cors-bundle": "^2.6.1",
        "phpdocumentor/reflection-docblock": "^5.6.6",
        "phpstan/phpdoc-parser": "^2.3.2",
        "symfony/asset": "7.3.*",
        "symfony/console": "7.3.5",
        "symfony/doctrine-messenger": "7.3.*",
        "symfony/dotenv": "7.3.2",
        "symfony/expression-language": "7.3.2",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "7.3.5",
        "symfony/mailer": "7.3.*",
        "symfony/messenger": "7.3.*",
        "symfony/monolog-bundle": "^3.11.1",
        "symfony/property-access": "7.3.3",
        "symfony/property-info": "7.3.5",
        "symfony/rate-limiter": "7.3.*",
        "symfony/runtime": "7.3.4",
        "symfony/security-bundle": "7.3.4",
        "symfony/security-http": "7.3.*",
        "symfony/serializer": "7.3.5",
        "symfony/translation": "7.3.*",
        "symfony/twig-bundle": "7.3.4",
        "symfony/validator": "7.3.5",
        "symfony/yaml": "7.3.5"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.94.2",
        "phpunit/phpunit": "^12.5.14",
        "symfony/browser-kit": "7.3.*",
        "symfony/css-selector": "7.3.*",
        "symfony/debug-bundle": "7.3.*",
        "symfony/http-client": "7.3.*",
        "symfony/maker-bundle": "^1.66",
        "symfony/stopwatch": "7.3.*",
        "symfony/web-profiler-bundle": "7.3.*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "generate:openapi": "php bin/console api:openapi:export --output=openapi/openapi.json",
        "migration": [
            "symfony console make:migration"
        ],
        "migrate": [
            "symfony console doctrine:migrations:migrate"
        ],
        "ss": [
            "symfony server:stop",
            "symfony server:start -d"
        ],
        "ssc": [
            "symfony server:stop",
            "symfony server:start --no-tls"
        ],
        "php-cs-fixer-check": "php-cs-fixer check src",
        "php-cs-fixer-fix": "php-cs-fixer fix src",
        "test": "php bin/phpunit --testdox",
        "test:filter": "php bin/phpunit --filter",
        "test:coverage": "php bin/phpunit --testdox --coverage-html var/coverage",
        "test:endpoints": "symfony console app:test:endpoint-coverage"
    }
}
